# Kopieer naar .env.local (lokaal) en zet dezelfde waarden in Cloudflare.
# NEXT_PUBLIC_* waarden worden tijdens de build in de app gezet.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alleen op de server. Nooit in de browser of in git.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
CRON_SECRET=lange-willekeurige-tekst
